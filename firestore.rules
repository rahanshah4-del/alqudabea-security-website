rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin only collections ─────────────────────
    match /guards/{doc} {
      allow read, write: if request.auth != null;
    }
    match /clients/{doc} {
      allow read, write: if request.auth != null;
    }
    match /sites/{doc} {
      allow read, write: if request.auth != null;
    }
    match /attendance/{doc} {
      allow read, write: if request.auth != null;
    }
    match /patrols/{doc} {
      allow read, write: if request.auth != null;
    }
    match /incidents/{doc} {
      allow read, write: if request.auth != null;
    }
    match /vehicles/{doc} {
      allow read, write: if request.auth != null;
    }
    match /shifts/{doc} {
      allow read, write: if request.auth != null;
    }
    match /visitors/{doc} {
      allow read, write: if request.auth != null;
    }
    match /notifications/{doc} {
      allow read, write: if request.auth != null;
    }
    match /tasks/{doc} {
      allow read, write: if request.auth != null;
    }
    match /reports/{doc} {
      allow read, write: if request.auth != null;
    }
    match /marketing/{doc} {
      allow read, write: if request.auth != null;
    }
    match /company/{doc} {
      allow read, write: if request.auth != null;
    }
    match /invoices/{doc} {
      allow read, write: if request.auth != null;
    }
    match /quotes/{doc} {
      allow read, write: if request.auth != null;
    }
    match /employees/{doc} {
      allow read, write: if request.auth != null;
    }
    match /interviews/{doc} {
      allow read, write: if request.auth != null;
    }
    match /users/{doc} {
      allow read, write: if request.auth != null;
    }
    match /missed_checkpoints/{doc} {
      allow read, write: if request.auth != null;
    }
    match /complaints/{doc} {
      allow read, write: if request.auth != null;
    }

    // ── Public read for contact submissions ────────
    match /contact_submissions/{doc} {
      allow create: if true;
      allow read: if request.auth != null;
    }

    // ── Deny everything else ───────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
